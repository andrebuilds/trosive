# Copy to `.env` and fill in. Next.js and prisma.config.ts both read `.env`.

# --- Database (Neon) ------------------------------------------------------
# `neon env pull` (Neon CLI) writes both of these for you — prefer that over
# copying them by hand, and it keeps the names below in sync.
#
# Pooled connection — the host contains "-pooler". Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection — same URL without "-pooler". Used by migrations,
# because pgBouncer can't run DDL inside a transaction.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional alias for the line above, for tooling that expects Prisma's name.
# DIRECT_URL=""

# --- Better Auth ----------------------------------------------------------
# Generate with: openssl rand -base64 32
# Also encrypts the workspaces' saved Anthropic keys: change it and every
# saved key becomes unreadable, so each workspace has to enter its key again.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: extra origins allowed to drive auth, comma-separated.
# BETTER_AUTH_TRUSTED_ORIGINS="https://staging.example.com"

# --- Email (Resend) -------------------------------------------------------
# Without a key, sign-in links and other emails are logged to the terminal.
RESEND_API_KEY=""
# Must be an address on a domain verified at https://resend.com/domains.
# Resend's sandbox sender (onboarding@resend.dev) only delivers to your own
# Resend account address, so it can't be used to reach real users.
EMAIL_FROM="Trosive <hello@trosive.com>"
# Optional. Transactional mail gets replied to — point this at an inbox someone
# reads rather than leaving replies to bounce off the From address.
EMAIL_REPLY_TO="support@trosive.com"

# --- Social sign-in (optional) --------------------------------------------
# Each provider appears in the auth dialogs only when both vars are set.
# Google:  https://console.cloud.google.com/apis/credentials
#   Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub:  https://github.com/settings/developers
#   Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Anthropic (Claude) ---------------------------------------------------
# Optional. Trosive is bring-your-own-key: each workspace saves its own
# Anthropic key in Settings > API key, encrypted with a key derived from
# BETTER_AUTH_SECRET (so rotating that secret means re-entering saved keys).
#
# Set this only to answer for every workspace that has no key of its own, e.g.
# on a private self-hosted instance. Leave it empty on a public one.
ANTHROPIC_API_KEY=""

# --- Admin console (/app/admin) -------------------------------------------
# Who can reach the admin console. Access is `user.role = "admin"`, set by
# another admin — this is the bootstrap for the first one, before anybody can
# promote anybody. Comma-separated user ids; leave empty once a real admin
# exists. Find an id with: select id, email from "user";
ADMIN_USER_IDS=""

# --- Data retention (admin console → Security) -----------------------------
# The retention window is set in the console; this is the shared secret a
# scheduler presents to run the purge:
#   POST /api/cron/retention   Authorization: Bearer $CRON_SECRET
# Generate with: openssl rand -base64 32
# Without it the route refuses every call — changing the window still purges
# once, but nothing sweeps chats that age past it later.
CRON_SECRET=""
