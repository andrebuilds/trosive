// Prisma 7: the connection URL lives in `prisma.config.ts`, not in this file.
//
// The models below are owned by Better Auth. Re-run `npm run auth:generate`
// after changing plugins or auth options, then create a migration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  members     Member[]
  invitations Invitation[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// Not a Better Auth model. Profile pictures live in Postgres and are served
/// by `app/api/avatar/[userId]`; `user.image` holds that URL.
model Avatar {
  id          String   @id @default(cuid())
  userId      String   @unique
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt

  @@map("avatar")
}

/// Not a Better Auth model. The admin console's activity log: who did what to
/// the app, and when.
///
/// Deliberately append-only and deliberately denormalised. `actorName` and
/// `description` are snapshots of how things read *at the time* — an audit
/// entry that changes when somebody renames themselves, or empties when an
/// account is deleted, is not much of an audit entry. Nothing cascades into
/// this table for the same reason.
model AdminLog {
  id          String   @id @default(cuid())
  /// The admin who acted. Null means the app itself did it — "System".
  actorId     String?
  /// Their name as it was then. Null renders as "System".
  actorName   String?
  /// Machine-readable slug, e.g. `user.created` — for filtering and the CSV.
  action      String
  /// The sentence after the actor's name, written when the event happened.
  description String
  /// What was acted on, when there is one thing: a user id, usually.
  targetId    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("adminLog")
}

/// Not a Better Auth model, and the only single-row table here: the app's own
/// switches, set from the admin console's Security tab. One row, id `app`.
///
/// Defaults matter — they're what the app runs on before an admin ever opens
/// the page, and `getAppSettings` returns them when the row is missing rather
/// than failing closed and locking everyone out.
model AppSetting {
  id                  String   @id @default("app")
  /// Off closes public registration. Admins can still create accounts.
  allowSignUps        Boolean  @default(true)
  /// Stored, not yet enforceable — there is no two-factor sign-in to require.
  enforceTwoFactor    Boolean  @default(false)
  /// On, only admins get past the `/app` boundary.
  maintenanceMode     Boolean  @default(false)
  /// Months of chat history kept. Null keeps everything for ever.
  chatRetentionMonths Int?     @default(12)
  /// The admin who last saved the page.
  updatedByUserId     String?
  updatedAt           DateTime @updatedAt

  @@map("appSetting")
}

/// Not a Better Auth model. Bring your own key: the Anthropic API key a
/// workspace pays for its answers with. Trosive has no plans and no limits, so
/// this row is what turns the chat on.
///
/// One per workspace, set by its owner or an admin; members use it without
/// ever seeing it. Like `Avatar`, a plain `organizationId` rather than a
/// relation, so `auth:generate` can rewrite the models above without knowing
/// about it.
///
/// The key itself is never stored in the clear: `ciphertext` is AES-256-GCM
/// under a key derived from `BETTER_AUTH_SECRET` (`lib/crypto.ts`). Rotating
/// that secret makes every stored key unreadable, and they have to be entered
/// again.
model WorkspaceApiKey {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  /// Only `anthropic` today. Stored so a second provider doesn't need a
  /// migration to tell the rows apart.
  provider        String    @default("anthropic")
  /// `v1.<iv>.<tag>.<data>`, base64url. See `encryptSecret`.
  ciphertext      String
  /// What the UI shows instead of the key: `sk-ant-…AbCd`.
  hint            String
  /// `valid` once Anthropic accepted it, `invalid` after it rejected it.
  status          String    @default("valid")
  lastVerifiedAt  DateTime?
  /// Why it was marked invalid, in words fit for the settings page.
  lastError       String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("workspaceApiKey")
}

/// Not a Better Auth model. Uploaded sources live in Postgres beside the text
/// Claude reads. Like `Avatar`, these carry plain `userId`/`organizationId`
/// columns rather than relations, so `auth:generate` can rewrite the models
/// above without needing to know about them.
model Document {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  name           String
  contentType    String
  sizeBytes      Int
  /// Pages for a PDF; null for formats without pagination.
  pageCount      Int?
  /// The original upload, kept so it can be served back and re-read later.
  data           Bytes
  /// Extracted plain text. Null for PDFs, which go to Claude as-is so it sees
  /// the layout rather than a flattened transcription.
  text           String?
  status         DocumentStatus @default(PROCESSING)
  failureReason  String?
  createdAt      DateTime       @default(now())
  chats          ChatDocument[]

  @@index([organizationId, createdAt])
  @@map("document")
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

model Chat {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  title          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  documents      ChatDocument[]
  messages       Message[]

  @@index([organizationId, updatedAt])
  @@map("chat")
}

/// Join row. `position` is the citation index — the `[n]` markers in an answer
/// resolve through it.
model ChatDocument {
  chatId     String
  documentId String
  position   Int
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([chatId, documentId])
  @@index([documentId])
  @@map("chatDocument")
}

model Message {
  id        String           @id @default(cuid())
  chatId    String
  chat      Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  /// Citations Claude returned, resolved to `{ index, document, page }`.
  sources   Json?
  /// The seeded brief-analysis request: sent to Claude for context, never
  /// rendered in the thread.
  hidden    Boolean          @default(false)
  /// Was this answer useful? Null until someone says. Only ever set on an
  /// ASSISTANT row.
  feedback  MessageFeedback?
  createdAt DateTime         @default(now())

  @@index([chatId, createdAt])
  @@map("message")
}

/// Not a Better Auth model, and deliberately not a relation of anything.
///
/// The usage ledger: one row per question asked. Nothing is charged against it
/// any more (answers are billed to the workspace's own Anthropic key), but the
/// home page, Usage and the admin console count it. `Message` can't be that
/// record: clearing chat history deletes it. Nothing cascades into this table.
model QuestionEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// The chat it was asked in. A plain column, not a relation: the chat may
  /// have been deleted, and this row has to outlive it.
  chatId         String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("questionEvent")
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageFeedback {
  UP
  DOWN
}
