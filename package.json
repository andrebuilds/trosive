{
  "name": "trosive",
  "version": "0.0.1",
  "description": "Ask questions across your documents and get answers that cite the exact passage they came from.",
  "license": "AGPL-3.0-only",
  "author": "Andrea D'Ambrosio (https://github.com/andrebuilds)",
  "homepage": "https://trosive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrebuilds/trosive.git"
  },
  "bugs": {
    "url": "https://github.com/andrebuilds/trosive/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "auth:generate": "better-auth generate --config lib/auth.ts --output prisma/schema.prisma -y && node scripts/sync-auth-schema.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@shadcn/react": "^0.3.1",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.33.0",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
